# gov-uk-corpus.env — environment for the corpus-shortlist service
#
# Copy to the server as ~/gov-uk-corpus.env (the corpus-shortlist systemd unit reads it),
# then replace every {{enter value}} with a real value. Lines without {{enter value}} are
# sensible defaults you can usually leave as-is. Restart the service after any change:
#   sudo systemctl restart corpus-shortlist
# Keep this file private (chmod 600) — it holds secrets. Never commit a filled-in copy.

# ── Database (Postgres) ─────────────────────────────────────────────────────
# Setting DB_HOST selects Postgres (otherwise the app falls back to a local SQLite
# file). Accounts mode below is Postgres-only.
DB_HOST={{enter value}}                 # Postgres host, e.g. localhost or an RDS/Lightsail endpoint
DB_PORT=5432
DB_NAME={{enter value}}                 # e.g. gov_uk_corpus
DB_USER={{enter value}}                 # the app's database role
DB_PASSWORD={{enter value}}             # secret — that role's password
DB_STATEMENT_TIMEOUT_MS=15000           # kill any single query after this many ms

# ── Authentication ──────────────────────────────────────────────────────────
# "accounts" = individual logins with roles (Postgres-only, what deployments use);
# "shared"   = one shared password (set DASHBOARD_PASSWORD instead of the accounts vars).
AUTH_MODE=accounts

# Permanent emergency admin (accounts mode). Required so you can always get in and
# grant a normal Admin; the account bypasses DB state and cannot be demoted/disabled.
BREAKGLASS_ADMIN_PASSWORD={{enter value}}   # secret

# Only for AUTH_MODE=shared (leave unset in accounts mode):
# DASHBOARD_PASSWORD={{enter value}}

# ── AI providers ────────────────────────────────────────────────────────────
# Configure at least one. Which model actually runs is chosen in Settings → Available Models.
#
# Anthropic (Claude API):
ANTHROPIC_API_KEY={{enter value}}           # secret, sk-ant-...
ANTHROPIC_WORKSPACE_ID={{enter value}}      # only for org-scoped ("Default") keys; else leave blank
#
# DeepSeek (Anthropic-compatible endpoint) — optional:
# DEEPSEEK_API_KEY={{enter value}}
#
# AWS Bedrock (Claude via AWS) — optional. A region is always required; then use EITHER
# a Bedrock API key (method 1) OR IAM SigV4 keys (method 2). Enter Bedrock model IDs in
# Settings (in eu-west-2 usually a cross-region profile, e.g. eu.anthropic.claude-...:0).
BEDROCK_AWS_REGION=eu-west-2
AWS_BEARER_TOKEN_BEDROCK={{enter value}}    # method 1 (simplest); or use the IAM keys below
# AWS_ACCESS_KEY_ID={{enter value}}         # method 2 — needs bedrock:InvokeModel
# AWS_SECRET_ACCESS_KEY={{enter value}}
# AWS_SESSION_TOKEN={{enter value}}         # only for temporary STS credentials

# ── GOV.UK Search tuning (optional; defaults shown) ─────────────────────────
GOVUK_RATE=2                            # requests/sec against the GOV.UK Search API
# GOVUK_MAX_PHRASES=25
# GOVUK_PER_PHRASE=10000
# GOVUK_MIN_ES_SCORE=0.005
# GOVUK_DOCTYPE_AGG=200

# ── AI call tuning (optional; defaults shown) ───────────────────────────────
# AI_EVAL_MAX_TOKENS=4096
# AI_TIMEOUT=45
# AI_MAX_RETRIES=4

# ── HTTPS hardening (set when the app is served over TLS) ───────────────────
# SECURE_COOKIES=1
# ENABLE_HSTS=1
