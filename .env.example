# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gov_uk_urls
DB_USER=gov_uk_crawler
DB_PASSWORD=your_secure_password_here

# Crawler Configuration
LOG_DIR=./logs
LOG_LEVEL=INFO
REPORT_DIR=./reports

# API Configuration (defaults in config.py)
# GOV_UK_SITEMAP_URL is hardcoded to https://www.gov.uk/sitemap.xml
# GOV_UK_API_BASE is hardcoded to https://www.gov.uk/api/content

# Server Configuration (for search API)
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# AI providers (the shortlist app picks the active provider/model in Settings)
# Anthropic (Claude API):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=          # only for org-scoped ("Default") keys
# DeepSeek (Anthropic-compatible endpoint):
# DEEPSEEK_API_KEY=
# AWS Bedrock (Claude via AWS) — uses AWS credentials, not an API key.
# Requires the model's access to be enabled in the Bedrock console for this region,
# and an IAM principal with bedrock:InvokeModel. Enter Bedrock model IDs in Settings
# (in eu-west-2 usually a cross-region inference profile, e.g. eu.anthropic.claude-...:0).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_REGION=eu-west-2      # or AWS_REGION / AWS_DEFAULT_REGION
# AWS_SESSION_TOKEN=               # only for temporary STS credentials
